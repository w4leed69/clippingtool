# Copy to .env (or export these) before running.

# Enables the AI script writer and AI highlight picking in the clipper.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional premium voices. Free Microsoft Edge neural voices are used otherwise.
ELEVENLABS_API_KEY=

# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# cpu or cuda
WHISPER_DEVICE=cpu

# Where uploads, backgrounds and rendered videos live.
DATA_DIR=./data
# How many renders run at the same time.
MAX_WORKERS=2
